<% delete_title_id = local_assigns.fetch(:delete_title_id, "delete-event-modal-title-#{event.id}") %>
<% edit_title_id = local_assigns.fetch(:edit_title_id, "edit-event-modal-title-#{event.id}") %>
<% return_params = local_assigns.fetch(:return_params, {}) %>

<div class="event-modal event-modal--confirm" data-modal-target="deleteOverlay" hidden>
  <div class="event-modal__panel event-modal__panel--confirm" role="dialog" aria-modal="true" aria-labelledby="<%= delete_title_id %>">
    <div class="event-modal__header event-modal__header--confirm">
      <h2 id="<%= delete_title_id %>">Confirm deletion</h2>
      <button type="button" class="event-modal__close" aria-label="Close" data-action="click->modal#closeDelete">×</button>
    </div>
    <p class="event-delete__message">
      Are you sure you want to delete event <strong><%= event.title %></strong>?
      <% if event.event_series.present? %>
        <br>
        This is a repeated event. Deleting it will also delete all repetitions of this event.
      <% end %>
    </p>
    <div class="event-delete__dialog-actions">
      <button type="button" class="button event-delete__cancel" data-action="click->modal#closeDelete">Cancel</button>
      <%= form_with url: event_path(event), method: :delete, data: { turbo: false } do |form| %>
        <%= hidden_field_tag :delete_scope, event.event_series.present? ? "series" : "single" %>
        <% return_params.each do |name, value| %>
          <%= hidden_field_tag name, value if value.present? %>
        <% end %>
        <%= form.submit "Delete event", class: "button event-delete__confirm" %>
      <% end %>
    </div>
  </div>
</div>

<div class="event-modal" data-modal-target="editOverlay" hidden>
  <div class="event-modal__panel" role="dialog" aria-modal="true" aria-labelledby="<%= edit_title_id %>">
    <div class="event-modal__header">
      <h2 id="<%= edit_title_id %>">Edit event</h2>
      <button type="button" class="event-modal__close" aria-label="Close" data-action="click->modal#closeEdit">×</button>
    </div>
    <% form_event = (@event_with_errors&.id == event.id ? @event_with_errors : event) %>
    <%= render "events/form", event: form_event, form_url: event_path(event), form_method: :patch, submit_label: "Save changes", return_params: return_params %>
  </div>
</div>
