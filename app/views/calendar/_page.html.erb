<% days = @calendar_days.in_groups_of(7) %>
<% calendar_view = @calendar_view || "month" %>
<% today = @today || Time.zone.today %>
<% selected_month = @current_month_start %>
<% selected_week = @current_week_start %>
<% previous_path = calendar_view == "week" ? calendar_path(view: "week", week: selected_week.prev_week.iso8601) : calendar_path(view: "month", month: selected_month.prev_month.strftime("%Y-%m")) %>
<% next_path = calendar_view == "week" ? calendar_path(view: "week", week: selected_week.next_week.iso8601) : calendar_path(view: "month", month: selected_month.next_month.strftime("%Y-%m")) %>
<% today_path = calendar_view == "week" ? calendar_path(view: "week", week: today.beginning_of_week(:monday).iso8601) : calendar_path(view: "month", month: today.strftime("%Y-%m")) %>
<% week_switch_start = selected_month == today.beginning_of_month ? today.beginning_of_week(:monday) : selected_month.beginning_of_week(:monday) %>
<% header_title = calendar_view == "week" ? "#{selected_week.strftime("%b %-d")} - #{selected_week.end_of_week(:monday).strftime("%b %-d, %Y")}" : selected_month.strftime("%B %Y") %>

<div id="calendar_page" class="calendar-shell" data-controller="modal" data-modal-open-value="<%= @open_event_modal.present? %>">
  <div class="calendar-shell__header">
    <div class="calendar-shell__left">
      <div class="calendar-shell__nav">
        <%= link_to "‹", previous_path, class: "calendar-shell__nav-button", data: { turbo_action: "replace" }, aria: { label: "Previous #{calendar_view}" } %>
        <%= link_to "›", next_path, class: "calendar-shell__nav-button", data: { turbo_action: "replace" }, aria: { label: "Next #{calendar_view}" } %>
      </div>
      <span class="calendar-shell__month"><%= header_title %></span>
    </div>
    <div class="calendar-shell__options">
      <%= link_to "Today", today_path, class: "calendar-shell__today-button", data: { turbo_action: "replace" } %>
      <div class="calendar-toggle" role="group" aria-label="Calendar view toggle">
        <%= link_to "Month", calendar_path(view: "month", month: selected_week.end_of_week(:monday).strftime("%Y-%m")), class: ("is-active" if calendar_view == "month"), data: { turbo_action: "replace" } %>
        <%= link_to "Week", calendar_path(view: "week", week: week_switch_start.iso8601), class: ("is-active" if calendar_view == "week"), data: { turbo_action: "replace" } %>
      </div>
      <button type="button" class="button button--primary" data-action="click->modal#openCreate">+ Add Event</button>
    </div>
  </div>

  <% if calendar_view == "week" %>
    <% hours = (0..23).to_a %>
    <% hour_height = 64 %>
    <div class="calendar-week-view" style="--hour-height: <%= hour_height %>px;" role="grid" aria-label="Weekly calendar" data-controller="week-calendar-scroll" data-week-calendar-scroll-hour-value="6" data-week-calendar-scroll-hour-height-value="<%= hour_height %>">
      <div class="calendar-week-view__viewport" data-week-calendar-scroll-target="viewport">
        <div class="calendar-week-view__header">
          <div class="calendar-week-view__corner" aria-hidden="true"></div>
          <div class="calendar-week-view__days">
            <% @week_days.each do |date| %>
              <% heading_classes = ["calendar-week-view__day-heading"] %>
              <% heading_classes << "calendar-week-view__day-heading--today" if date == today %>
              <div class="<%= heading_classes.join(" ") %>">
                <span class="calendar-week-view__day-name"><%= date.strftime("%a") %></span>
                <span class="calendar-week-view__day-number"><%= date.day %></span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="calendar-week-view__body">
          <div class="calendar-week-view__times" aria-hidden="true">
            <% hours.each do |hour| %>
              <span><%= format("%02d:00", hour) %></span>
            <% end %>
          </div>

          <div class="calendar-week-view__grid">
            <div class="calendar-week-view__hour-lines" aria-hidden="true"></div>

            <% @week_days.each_with_index do |date, day_index| %>
              <% column_classes = ["calendar-week-view__day-column"] %>
              <% column_classes << "calendar-week-view__day-column--today" if date == today %>
              <div class="<%= column_classes.join(" ") %>" role="gridcell" aria-label="<%= date.strftime("%A, %B %-d") %>">
                <% timed_events = Array(@events_by_date[date]) %>
                <% event_layouts = {} %>
                <% timed_events.each do |event| %>
                  <% starts_at = event.starts_at.in_time_zone %>
                  <% ends_at = event.ends_at.in_time_zone %>
                  <% starts_minutes = event.all_day? ? 0 : starts_at.hour * 60 + starts_at.min %>
                  <% duration_minutes = event.all_day? ? 24 * 60 : [((ends_at - starts_at) / 60).round, 1].max %>
                  <% event_layouts[event.id] = { start: starts_minutes, end_time: starts_minutes + duration_minutes, index: 0, count: 1 } %>
                <% end %>
                <% timed_events.each do |event| %>
                  <% layout = event_layouts[event.id] %>
                  <% overlapping_events = timed_events.select do |other_event| %>
                    <% other_layout = event_layouts[other_event.id] %>
                    <% layout[:start] < other_layout[:end_time] && other_layout[:start] < layout[:end_time] %>
                  <% end %>
                  <% overlapping_events.each_with_index do |overlap_event, overlap_index| %>
                    <% event_layouts[overlap_event.id][:index] = [event_layouts[overlap_event.id][:index], overlap_index].max %>
                    <% event_layouts[overlap_event.id][:count] = [event_layouts[overlap_event.id][:count], overlapping_events.size].max %>
                  <% end %>
                <% end %>

                <% timed_events.each do |event| %>
                  <% starts_at = event.starts_at.in_time_zone %>
                  <% ends_at = event.ends_at.in_time_zone %>
                  <% starts_minutes = event.all_day? ? 0 : starts_at.hour * 60 + starts_at.min %>
                  <% duration_minutes = event.all_day? ? 24 * 60 : [((ends_at - starts_at) / 60).round, 1].max %>
                  <% layout = event_layouts[event.id] %>
                  <% top = starts_minutes / 60.0 * hour_height %>
                  <% height = duration_minutes / 60.0 * hour_height %>
                  <% event_classes = ["calendar-week-view__event"] %>
                  <% event_classes << "calendar-week-view__event--all-day" if event.all_day? %>
                  <div class="<%= event_classes.join(" ") %>" style="top: <%= top %>px; height: <%= height %>px; --overlap-index: <%= layout[:index] %>; --overlap-count: <%= layout[:count] %>;">
                    <%= render "calendar/event_chip", event: event, days: @week_days, week_index: day_index, popover_context: :week %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="calendar-weekdays">
      <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day_name| %>
        <span><%= day_name %></span>
      <% end %>
    </div>

    <div class="calendar-grid" role="grid" aria-label="Monthly calendar">
      <% days.each_with_index do |week, week_index| %>
        <div class="calendar-grid__row" role="row">
          <% week.each do |date| %>
            <% classes = ["calendar-cell"] %>
            <% classes << "calendar-cell--muted" if date.month != @current_month_start.month %>
            <% classes << "calendar-cell--today" if date == today %>
            <% events = Array(@events_by_date[date]) %>
            <% visible_events = events.first(2) %>
            <% hidden_events = events.drop(2) %>
            <div class="<%= classes.join(" ") %>" role="gridcell" aria-label="<%= date.strftime("%A, %B %-d") %>" <%= tag.attributes(data: hidden_events.any? ? { controller: "day-popover", action: "click@window->day-popover#closeFromOutside keydown.esc@window->day-popover#close" } : {}) %>>
              <span class="calendar-cell__day"><%= date.day %></span>
              <div class="calendar-cell__events">
                <% visible_events.each do |event| %>
                  <%= render "calendar/event_chip", event: event, days: days, week_index: week_index %>
                <% end %>

                <% if hidden_events.any? %>
                  <button type="button" class="calendar-cell__more-button" data-day-popover-target="trigger" data-action="click->day-popover#open" aria-expanded="false">
                    +<%= hidden_events.size %> more
                  </button>
                <% end %>
              </div>

              <% if hidden_events.any? %>
                <div class="day-popover" data-day-popover-target="panel" hidden>
                  <div class="day-popover__header">
                    <div>
                      <span class="day-popover__eyebrow"><%= date.strftime("%A") %></span>
                      <h3 class="day-popover__title"><%= date.strftime("%B %-d") %></h3>
                    </div>
                    <button type="button" class="day-popover__close" data-action="click->day-popover#close" aria-label="Close day events">×</button>
                  </div>
                  <div class="day-popover__events">
                    <% events.each do |event| %>
                      <%= render "calendar/event_chip", event: event, days: days, week_index: week_index %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="event-modal" data-modal-target="overlay" data-action="click->modal#closeCreateFromBackdrop" hidden>
    <div class="event-modal__panel" role="dialog" aria-modal="true" aria-labelledby="event-modal-title">
      <div class="event-modal__header">
        <h2 id="event-modal-title">Create event</h2>
        <button type="button" class="event-modal__close" aria-label="Close" data-action="click->modal#closeCreate">×</button>
      </div>
      <%= render "events/form", event: @new_event %>
    </div>
  </div>
</div>
