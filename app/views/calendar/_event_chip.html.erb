<div data-controller="event-modal delete-modal" data-event-modal-open-value="<%= @event_with_errors&.id == event.id %>">
  <% popover_classes = ["event-popover"] %>
  <% popover_classes << "event-popover--up" if week_index >= (days.length - 2) %>
  <details class="<%= popover_classes.join(' ') %>" data-controller="event-popover" data-action="toggle->event-popover#handleToggle click@window->event-popover#closeFromOutside keydown.esc@window->event-popover#close">
    <summary class="event-chip event-chip--<%= event.color %>">
      <span class="event-chip__title"><%= event.title %></span>
      <span class="event-chip__time"><%= event.all_day? ? "All day" : event.starts_at.strftime("%H:%M") %></span>
    </summary>
    <div class="event-popover__panel event-popover__panel--<%= event.color %>">
      <p class="event-popover__title"><%= event.title %></p>
      <div class="event-popover__rows">
      <% if event.description.present? %>
        <div class="event-popover__row">
          <span class="event-popover__label">Description</span>
          <p class="event-popover__value event-popover__description"><%= event.description %></p>
        </div>
      <% end %>

        <div class="event-popover__row">
          <span class="event-popover__label">Date</span>
          <p class="event-popover__value"><%= event.starts_at.strftime("%A, %B %-d, %Y") %></p>
        </div>

        <div class="event-popover__row">
          <span class="event-popover__label">Time</span>
          <p class="event-popover__value">
            <% if event.all_day? %>
              Full day event
            <% else %>
              <%= event.starts_at.strftime("%H:%M") %> - <%= event.ends_at.strftime("%H:%M") %>
            <% end %>
          </p>
        </div>

        <% if event.event_series.present? %>
          <% repeat_spec = case event.event_series.repeat_frequency
            when "weekly"
              "every #{event.starts_at.strftime('%A')}"
            when "monthly"
              "every #{event.starts_at.day.ordinalize}"
            when "daily"
              "every day"
            else
              "every #{event.event_series.repeat_frequency}"
          end %>
          <div class="event-popover__row">
            <span class="event-popover__label">Repeats</span>
            <p class="event-popover__value">Repeats <%= event.event_series.repeat_frequency %> (<%= repeat_spec %>)</p>
          </div>
        <% end %>
      </div>

      <div class="event-popover__actions">
        <button type="button" class="button button--ghost event-popover__action" data-action="click->event-modal#open">Edit</button>
        <button type="button" class="button event-delete__summary" data-action="click->delete-modal#open">Delete</button>
      </div>
    </div>
  </details>

  <%= render "calendar/event_dialogs", event: event, return_params: params.permit(:view, :month, :week).to_h %>
</div>
